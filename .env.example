# Local Docker development settings only.
# Do not use these values for production.

POSTGRES_DB=exchange_ops
POSTGRES_USER=exchange_ops
POSTGRES_PASSWORD=exchange_ops
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Explicit browser origins allowed to call the backend.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

JAVA_OPTS=-Xms256m -Xmx512m

# Controlled synthetic event generator
GENERATOR_INTERVAL_MS=1000
GENERATOR_EVENTS_PER_CYCLE=1
GENERATOR_RANDOM_SEED=2026

# Controlled synthetic event generator
GENERATOR_INTERVAL_MS=1000
GENERATOR_EVENTS_PER_CYCLE=1
GENERATOR_RANDOM_SEED=2026
