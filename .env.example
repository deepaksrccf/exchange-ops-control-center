# Exchange Operations Control Center - example environment
# Copy to .env and adjust. NEVER commit a real .env file.

# --- PostgreSQL ---
# Consumed by docker-compose.yml. These are local development defaults, not secrets.
POSTGRES_DB=exchangeops
POSTGRES_USER=exchangeops
# Local development placeholder only. Use a secret manager for anything shared.
POSTGRES_PASSWORD=exchangeops_local_dev
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Use `local` when running the backend on the host against the Compose database,
# `docker` when the backend itself runs as a container.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/exchangeops
SPRING_DATASOURCE_USERNAME=exchangeops
SPRING_DATASOURCE_PASSWORD=exchangeops_local_dev
# Comma-separated explicit origins. Wildcards are rejected in non-dev profiles.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
